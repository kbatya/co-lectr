# Copy to .env and fill in. .env is git-ignored; this file is not.

# Layer 2 — the reviewer agent. https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key

# 0 = Gemini API (the key above). 1 = go through Vertex AI instead.
GOOGLE_GENAI_USE_ENTERPRISE=0

# Firestore. Leave both unset to run without persistence - the CLI says so and continues.
GOOGLE_APPLICATION_CREDENTIALS=.secrets/your-service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Webhook receiver (co_lectr.web on Cloud Run). The shared secret you set on the
# GitHub webhook; every delivery is HMAC-checked against it. Unset = every POST
# to /webhook is refused. Set it as a Cloud Run env var in production, not here.
GITHUB_WEBHOOK_SECRET=a-long-random-string

# Optional.
# COLECTR_MODEL=gemini-3.5-flash
# COLECTR_SUBMISSIONS_ROOT=/path/to/the/course/checkout

# Durable worker (production, optional). Set all three to push reviews onto Cloud
# Tasks instead of the in-process pool — retries + a dead-letter queue. Leave unset
# to use the bounded pool (size COLECTR_MAX_INFLIGHT, default 4).
# COLECTR_TASKS_QUEUE=projects/<project>/locations/<region>/queues/<queue>
# COLECTR_TASKS_HANDLER_URL=https://<service-url>/tasks/review
# COLECTR_TASKS_SECRET=a-long-random-string
